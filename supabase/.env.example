# 이 파일을 .env 로 복사한 뒤 Supabase 대시보드의 값으로 채운다.
# .env 는 .gitignore 에 걸려 있어 커밋되지 않는다.
#
# 값은 Supabase 대시보드 > Project Settings > API 에서 복사한다.

# 프로젝트 주소. 예: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# anon (public) 키.
#
# 이 키는 브라우저로 내려간다. 그래도 되는 키다 — 이 키만으로는 아무 행도
# 읽거나 쓸 수 없고, 로그인해서 받은 토큰과 RLS 정책이 실제 차단을 한다.
#
# service_role 키를 여기 넣으면 안 된다. 그 키는 RLS 를 통째로 우회하므로
# 브라우저로 내려가는 순간 누구나 모든 사람의 데이터를 읽을 수 있게 된다.
# 서버가 시작할 때 이 값이 service_role 인지 검사해서 거부한다.
SUPABASE_ANON_KEY=

# 서버 포트
PORT=3100
